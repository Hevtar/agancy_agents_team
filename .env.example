# Polza.Ai Configuration
POLZA_AI_API_KEY=your_polza_ai_api_key_here
POLZA_AI_BASE_URL=https://polza.ai/api/v1

# Database Configuration
POSTGRES_DB=agency_db
POSTGRES_USER=agency_user
POSTGRES_PASSWORD=agency_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ChromaDB Configuration
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_COLLECTION_AGENCY=agency_team_kb
CHROMADB_COLLECTION_PROCESSES=agency_processes_kb

# Application Configuration
APP_ENV=development  # development, production, sandbox
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-secret-key-change-in-production

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Token Budget (daily limit)
DAILY_TOKEN_BUDGET=100000
TOKEN_BUDGET_WARNING_THRESHOLD=0.80

# Sandbox Configuration (for sandbox environment)
SANDBOX_MOCK_POLZA=false
SANDBOX_TOKEN_LIMIT=10000
SANDBOX_MAX_AGENTS=5